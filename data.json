        },
        {
          "label": "Log in",
          "to": "login",
          "icon": "in",
          "style": "ghost"
        },
        {
          "label": "Admin access",
          "to": "dashboard",
          "icon": "shield",
          "style": "ghost"
        }
      ],
      "visitor": {
        "label": "Enter as visitor",
        "icon": "eye",
        "message": "Welcome, visitor. You can only browse the home page.",
        "banner": "Visitor mode: browsing limited to the home page.",
        "exit": "Exit",
        "exitMessage": "Visitor mode exited.",
        "locked": "Visitor mode: create an account or exit this mode to continue.",
        "note": "Buttons are locked in visitor mode."
      },
      "panel": {
        "top": [
          "FACILO",
          "AVAILABLE"
        ],
        "bottom": "Search · Find · Take",
        "badges": [
          "Found near you",
          "Ready to take"
        ]
      },
      "featuresEyebrow": "Features",
      "featuresTitle": "Three steps, nothing more.",
      "features": [
        {
          "title": "Search",
          "text": "One search bar, clear results from the first letters.",
          "icon": "search"
        },
        {
          "title": "Find",
          "text": "Every result shows where it is and whether it’s available.",
          "icon": "pin"
        },
        {
          "title": "Take",
          "text": "Reserve in one tap and pick it up whenever suits you.",
          "icon": "bag"
        }
      ],
      "footer": "© 2026 Facilo — chercher-la, trouve-la et prendre-le"
    },
    "signup": {
      "file": "signup.html",
      "nav": "Sign up",
      "icon": "user",
      "eyebrow": "Sign up",
      "title": "Create an account",
      "subtitle": "It only takes a few seconds.",
      "submit": "Create my account",
      "switch": {
        "text": "Already registered?",
        "label": "Log in",
        "to": "login"
      },
      "fields": [
        {
          "name": "fullname",
          "label": "Full name",
          "type": "text",
          "icon": "user",
          "placeholder": "e.g. Salma Benali",
          "autocomplete": "name",
          "required": true,
          "minLength": 2,
          "error": "Enter your full name."
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "icon": "mail",
          "placeholder": "you@example.com",
          "autocomplete": "email",
          "required": true,
          "error": "Enter a valid email address."
        },
        {
          "name": "password",
          "label": "Password",
          "type": "password",
          "icon": "lock",
          "placeholder": "8 characters minimum",
          "autocomplete": "new-password",
          "required": true,
          "minLength": 8,
          "error": "Password must be at least 8 characters."
        },
        {
          "name": "confirm",
          "label": "Confirm password",
          "type": "password",
          "icon": "lock",
          "autocomplete": "new-password",
          "required": true,
          "matches": "password",
          "error": "The two passwords don’t match."
        }
      ],
      "checks": [
        {
          "name": "terms",
          "text": "I accept Facilo’s terms of use.",
          "required": true,
          "error": "Accept the terms of use to continue."
        }
      ],
      "successMessage": "Account created. Welcome to Facilo.",
      "redirect": "index.html"
    },
    "login": {
      "file": "login.html",
      "nav": "Log in",
      "icon": "in",
      "eyebrow": "Log in",
      "title": "Welcome back",
      "subtitle": "Pick up your searches where you left off.",
      "submit": "Log in",
      "switch": {
        "text": "No account yet?",
        "label": "Sign up",
        "to": "signup"
      },
      "fields": [
        {
          "name": "email",
          "label": "Email address",
          "type": "email",
          "icon": "mail",
          "placeholder": "you@example.com",
          "autocomplete": "email",
          "required": true,
          "error": "Enter a valid email address."
        },
        {
          "name": "password",
          "label": "Password",
          "type": "password",
          "icon": "lock",
          "autocomplete": "current-password",
          "required": true,
          "error": "Enter your password."
        }
      ],
      "remember": "Remember me",
      "forgot": "Forgot password?",
      "forgotMessage": "A reset link will be sent to your email.",
      "social": [
        "Google",
        "Facebook"
      ],
      "socialMessage": "login: coming soon.",
      "successMessage": "Logged in. Welcome to Facilo.",
      "redirect": "index.html"
    },
    "dashboard": {
      "file": "dashboard.html",
      "nav": "Admin",
      "icon": "shield",
      "eyebrow": "Administration",
      "title": "Admin access",
      "subtitle": "Enter your access code to open the dashboard.",
